<% content_for :title, "My orders" %>

<div class="admin-page__header">
  <h1>My orders</h1>
</div>

<% if @orders.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Order</th>
        <th>Placed</th>
        <th>Items</th>
        <th>Shipping</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr id="<%= dom_id(order) %>">
          <td><%= link_to order.number, order_path(order) %></td>
          <td><%= order.placed_at.to_fs(:long) %></td>
          <td><%= safe_join(order.order_items.map { |i| "#{i.quantity} × #{i.product_name}" }, tag.br) %></td>
          <td><%= order.shipping_option&.label || "—" %></td>
          <td><%= order.legacy? ? "Price not recorded" : format_price(order.total_cents) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="admin-page__empty">No orders yet. <%= link_to "Browse products", root_path %></p>
<% end %>
