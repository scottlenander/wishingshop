<% content_for :title, "Cart" %>

<div class="admin-page__header">
  <h1>Your cart</h1>
</div>

<% if @items.empty? %>
  <p class="admin-page__empty">Your cart is empty. <%= link_to "Browse products", root_path %></p>
<% else %>
  <% @problems.each do |problem| %>
    <p class="error cart__problem" data-testid="cart-problem"><%= problem %></p>
  <% end %>

  <div class="cart">
    <ul class="cart__items">
      <% @items.each do |item| %>
        <% product = item.product %>
        <li class="cart__item" id="cart_item_<%= item.id %>" data-testid="cart-item">
          <% if product.featured_image.attached? %>
            <%= image_tag product.featured_image.variant(:thumb), alt: "", class: "cart__image" %>
          <% else %>
            <div class="cart__image products-index__card-placeholder"></div>
          <% end %>

          <div class="cart__details">
            <h2 class="cart__name"><%= link_to product.name, product %></h2>
            <p class="cart__unit-price"><%= format_price(product.price_cents) %> each</p>

            <div class="cart__actions">
              <%= form_with url: cart_item_path(item), method: :patch, class: "cart__quantity-form" do |form| %>
                <%= form.label :quantity, "Quantity", for: "quantity_#{item.id}", class: "cart__quantity-label" %>
                <%= form.number_field :quantity, id: "quantity_#{item.id}", value: item.quantity, min: 0, max: product.inventory_count,
                                                  class: "products-inventory__quantity", aria: { label: "Quantity for #{product.name}" } %>
                <%= form.submit "Update", class: "btn btn--secondary", aria: { label: "Update #{product.name}" } %>
              <% end %>
              <%= button_to "Remove", cart_item_path(item), method: :delete, class: "btn btn--danger", aria: { label: "Remove #{product.name}" } %>
            </div>
          </div>

          <p class="cart__line-total" data-testid="line-total"><%= format_price(item.line_total_cents) %></p>
        </li>
      <% end %>
    </ul>

    <aside class="cart__summary" aria-labelledby="cart-summary-title">
      <h2 id="cart-summary-title">Summary</h2>
      <dl class="cart__totals">
        <dt>Subtotal (<%= pluralize(@cart.item_count, "item") %>)</dt>
        <dd class="cart__subtotal" data-testid="cart-subtotal"><%= format_price(@cart.subtotal_cents) %></dd>
      </dl>
      <% remaining = ShippingMethod::FREE_STANDARD_THRESHOLD_CENTS - @cart.subtotal_cents %>
      <p class="cart__shipping-note" data-testid="shipping-note">
        <% if remaining.positive? %>
          Add <%= format_price(remaining) %> more for free standard shipping.
        <% else %>
          Your order qualifies for free standard shipping.
        <% end %>
      </p>

      <% if @problems.any? %>
        <button type="button" class="btn cart__checkout" data-testid="cart-checkout" disabled>Checkout</button>
        <p class="admin-form__hint">Fix the items above to check out.</p>
      <% else %>
        <%= link_to "Checkout", checkout_path, class: "btn cart__checkout", data: { testid: "cart-checkout" } %>
        <% unless authenticated? %>
          <p class="admin-form__hint">You'll log in before paying. Your cart is kept.</p>
        <% end %>
      <% end %>
    </aside>
  </div>
<% end %>
