<%= form_with model: product, class: "form-card products-form", data: { testid: "product-form" } do |form| %>
  <% if form.object.errors.any? %>
    <p class="error" data-testid="form-error"><%= form.object.errors.full_messages.first %></p>
  <% end %>

  <div class="products-form__field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="products-form__field">
    <%= form.label :category %>
    <%= form.select :category, Product::CATEGORY_LABELS.invert, { prompt: "Choose a category" }, required: true %>
  </div>

  <div class="products-form__field">
    <%= form.label :sku, "SKU" %>
    <%= form.text_field :sku, placeholder: "Leave blank to create from the name", autocapitalize: "characters" %>
  </div>

  <div class="products-form__field">
    <%= form.label :description %>
    <%# The editor is a <trix-editor>, which the label above doesn't name, so it gets its own. %>
    <%= form.rich_textarea :description, aria: { label: "Description" } %>
  </div>

  <div class="products-form__field">
    <%= form.label :featured_image %>
    <%= form.file_field :featured_image, accept: "image/*" %>
  </div>

  <div class="products-form__field">
    <%= form.label :price, "Price ($)" %>
    <%= form.text_field :price, value: (product.price && format("%.2f", product.price)), inputmode: "decimal", placeholder: "19.99" %>
  </div>

  <div class="products-form__field">
    <%= form.label :inventory_count %>
    <%= form.number_field :inventory_count %>
  </div>

  <div class="products-form__actions">
    <%= form.submit %>
  </div>
<% end %>
