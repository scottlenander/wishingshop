<p><%= link_to "Back", products_path, class: "products-show__back" %></p>

<%= tag.section class: ["products-show__product", { "products-show__product--no-image": !@product.featured_image.attached? }] do %>
  <%= image_tag @product.featured_image, alt: @product.name, class: "products-show__image" if @product.featured_image.attached? %>

  <section class="products-show__info">
    <%# Links back to this category's section on the products page. %>
    <% if @product.category %>
      <p class="products-show__category">
        <%= link_to @product.category_label, products_path(anchor: "category-#{@product.category}"),
                    aria: { label: "Category: #{@product.category_label}" } %>
      </p>
    <% end %>
    <h1 class="products-show__title"><%= @product.name %></h1>

    <%# Not cached: reviews change without touching the product. %>
    <p class="products-show__rating">
      <% if @rating_summary.any? %>
        <%= link_to "#reviews", class: "products-show__rating-link" do %>
          <span aria-hidden="true"><%= star_rating(@rating_summary.average) %></span>
          <span class="products-show__rating-text"><%= @rating_summary.average %> out of 5 · <%= pluralize(@rating_summary.count, "review") %></span>
        <% end %>
      <% else %>
        <span class="products-show__unrated">Not yet rated</span>
      <% end %>
    </p>

    <% cache @product do %>
      <div class="products-show__description"><%= @product.description %></div>
    <% end %>

    <%= render "products/inventory", product: @product %>

    <% if admin? %>
      <div class="products-show__actions">
        <%= link_to "Edit", edit_product_path(@product), class: "btn btn--secondary products-show__edit" %>
        <%= link_to "Feature this product", new_admin_featured_product_path(product_id: @product.id), class: "btn btn--secondary" %>
        <%= button_to "Delete", @product, method: :delete, class: "btn btn--danger products-show__delete", data: { turbo_confirm: "Are you sure?" } %>
      </div>
    <% end %>
  </section>
<% end %>

<%= render "reviews/section", product: @product %>
