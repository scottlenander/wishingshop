<p><%= link_to "Back", products_path, class: "products-show__back" %></p>

<%= tag.section class: ["products-show__product", { "products-show__product--no-image": !@product.featured_image.attached? }] do %>
  <%= image_tag @product.featured_image, class: "products-show__image" if @product.featured_image.attached? %>

  <section class="products-show__info">
    <% cache @product do %>
      <h1 class="products-show__title"><%= @product.name %></h1>
      <div class="products-show__description"><%= @product.description %></div>
    <% end %>

    <%= render "products/inventory", product: @product %>

    <% if admin? %>
      <div class="products-show__actions">
        <%= link_to "Edit", edit_product_path(@product), class: "btn btn--secondary products-show__edit" %>
        <%= link_to "Feature this product", new_admin_featured_product_path(product_id: @product.id), class: "btn btn--secondary" %>
        <%= button_to "Delete", @product, method: :delete, class: "btn btn--danger products-show__delete", data: { turbo_confirm: "Are you sure?" } %>
      </div>
    <% end %>
  </section>
<% end %>

<%= render "reviews/section", product: @product %>
