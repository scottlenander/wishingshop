<% if @announcements.any? || @featured %>
  <%= tag.section class: ["products-index__hero", { "products-index__hero--single": @announcements.none? || @featured.nil? }] do %>
    <%= render "announcements", announcements: @announcements if @announcements.any? %>
    <%= render "featured", product: @featured, source: @featured_source, rating: @ratings[@featured.id] if @featured %>
  <% end %>
<% end %>

<h1><%= t ".title" %></h1>

<%= link_to "New product", new_product_path, class: "products-index__action" if admin? %>

<%# One section per category, in Product::CATEGORY_LABELS order. %>
<div id="products" class="products-index__categories">
  <% @product_groups.each do |key, label, products| %>
    <section class="products-index__category" id="category-<%= key %>" aria-labelledby="category-<%= key %>-title">
      <h2 id="category-<%= key %>-title" class="products-index__category-title" data-testid="category-title"><%= label %></h2>
      <div class="products-index__grid" data-testid="product-grid">
        <%= render partial: "card", collection: products, as: :product %>
      </div>
    </section>
  <% end %>
</div>
