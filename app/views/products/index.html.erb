<% if @announcements.any? || @featured %>
  <%= tag.section class: ["products-index__hero", { "products-index__hero--single": @announcements.none? || @featured.nil? }] do %>
    <%= render "announcements", announcements: @announcements if @announcements.any? %>
    <%= render "featured", product: @featured, source: @featured_source, rating: @ratings[@featured.id] if @featured %>
  <% end %>
<% end %>

<h1><%= t ".title" %></h1>

<%= link_to "New product", new_product_path, class: "products-index__action" if admin? %>

<div id="products" class="products-index__grid">
  <% @products.each do |product| %>
    <div class="products-index__card">
      <% if product.featured_image.attached? %>
        <%= image_tag product.featured_image.variant(:thumb), alt: "", loading: "lazy", class: "products-index__card-image" %>
      <% else %>
        <div class="products-index__card-placeholder"></div>
      <% end %>
      <%= link_to product.name, product_path(product.id), class: "products-index__card-link" %>
      <%= render "card_rating", rating: @ratings[product.id] %>
      <% if product.for_sale? %>
        <p class="products-index__card-price"><%= format_price(product.price_cents) %></p>
      <% end %>
    </div>
  <% end %>
</div>
