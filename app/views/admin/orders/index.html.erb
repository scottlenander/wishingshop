<% content_for :title, "Orders" %>

<div class="admin-page__header">
  <h1>Orders</h1>
</div>

<% if @orders.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Order</th>
        <th>Customer</th>
        <th>Items</th>
        <th>Shipping</th>
        <th>Total</th>
        <th>Placed</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr id="<%= dom_id(order) %>" data-testid="admin-order-row">
          <td data-testid="order-number"><%= order.number %></td>
          <td><%= order.user.full_name %><%= tag.span("Deactivated", class: "admin-page__tag") if order.user.deactivated? %><br><%= order.user.email_address %></td>
          <td><%= safe_join(order.order_items.map { |i| "#{i.quantity} × #{i.product_name}" }, tag.br) %></td>
          <td><%= order.shipping_option&.label || "—" %></td>
          <td><%= order.legacy? ? "Not recorded" : format_price(order.total_cents) %></td>
          <td><%= order.placed_at.to_fs(:short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="admin-page__empty">No orders yet.</p>
<% end %>
