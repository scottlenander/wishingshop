<% content_for :title, "Users" %>

<div class="admin-page__header">
  <h1>Users</h1>
  <%= link_to "New user", new_admin_user_path, class: "btn" %>
</div>

<% if @users.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Email</th>
        <th>Joined</th>
        <th class="admin-table__actions-heading">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr id="<%= dom_id(user) %>">
          <td><%= user.email_address %></td>
          <td><%= user.created_at.to_date.to_fs(:long) %></td>
          <td class="admin-table__actions">
            <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn--secondary" %>
            <%= button_to "Delete", admin_user_path(user), method: :delete, class: "btn btn--danger", data: { turbo_confirm: "Delete #{user.email_address}?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="admin-page__empty">No standard users yet.</p>
<% end %>
