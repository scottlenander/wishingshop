<% content_for :title, "Subscribers" %>

<div class="admin-page__header">
  <h1>Subscribers</h1>
  <%= link_to "New subscriber", new_admin_subscriber_path, class: "btn" %>
</div>

<% if @subscribers_by_product.any? %>
  <% @subscribers_by_product.each do |product, subscribers| %>
    <section class="admin-subscribers__group">
      <h2 class="admin-subscribers__product">
        <%= link_to product.name, product %>
        <span class="admin-subscribers__stock <%= "admin-subscribers__stock--out" if product.inventory_count.zero? %>">
          <%= product.inventory_count.positive? ? "#{product.inventory_count} in stock" : "Out of stock" %>
        </span>
      </h2>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Subscribed</th>
            <th class="admin-table__actions-heading">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% subscribers.each do |subscriber| %>
            <tr id="<%= dom_id(subscriber) %>">
              <td><%= subscriber.email %></td>
              <td><%= subscriber.created_at.to_date.to_fs(:long) %></td>
              <td class="admin-table__actions">
                <%= link_to "Edit", edit_admin_subscriber_path(subscriber), class: "btn btn--secondary" %>
                <%= button_to "Remove", admin_subscriber_path(subscriber), method: :delete, class: "btn btn--danger", data: { turbo_confirm: "Remove #{subscriber.email} from #{product.name}?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
<% else %>
  <p class="admin-page__empty">No subscribers yet.</p>
<% end %>
