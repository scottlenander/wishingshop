<%= form_with model: [ :admin, featured_product ], class: "form-card" do |form| %>
  <% if form.object.errors.any? %>
    <p class="error" data-testid="form-error"><%= form.object.errors.full_messages.first %></p>
  <% end %>

  <div>
    <%= form.label :product_id, "Product" %>
    <%= form.collection_select :product_id, Product.order(:name), :id, :name, { prompt: "Choose a product" }, required: true %>
  </div>

  <div class="admin-form__row">
    <div>
      <%= form.label :starts_at, "From" %>
      <%= form.datetime_local_field :starts_at, required: true %>
    </div>
    <div>
      <%= form.label :ends_at, "Until" %>
      <%= form.datetime_local_field :ends_at, required: true %>
    </div>
  </div>
  <p class="admin-form__hint">Only one product can be featured at a time, so picks can't overlap. Times are <%= Time.zone.name %>.</p>

  <%= form.submit "Save" %>
<% end %>
