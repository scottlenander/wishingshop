<!DOCTYPE html>
<html lang="en">
  <head>
    <%# Page title first, then the site name, e.g. "Users · WishingShop". %>
    <title><%= [ content_for(:title), "WishingShop" ].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WishingShop">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="layouts-application__nav">
      <%= link_to root_path, class: "layouts-application__brand" do %>
        <%# Magic wand with stars. Decorative: the link's name is "WishingShop". %>
        <svg class="layouts-application__logo" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
          <line x1="3" y1="21" x2="13" y2="11" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
          <line x1="13" y1="11" x2="14.8" y2="9.2" class="layouts-application__logo-star" stroke-width="2.6" stroke-linecap="round" />
          <path class="layouts-application__logo-star" d="M17 1.5Q17 6 21.5 6Q17 6 17 10.5Q17 6 12.5 6Q17 6 17 1.5Z" />
          <path class="layouts-application__logo-star" d="M21.5 10Q21.5 12 23.5 12Q21.5 12 21.5 14Q21.5 12 19.5 12Q21.5 12 21.5 10Z" />
          <path class="layouts-application__logo-star" d="M9.5 1Q9.5 3 11.5 3Q9.5 3 9.5 5Q9.5 3 7.5 3Q9.5 3 9.5 1Z" />
        </svg>
        WishingShop
      <% end %>
      <% if authenticated? %>
        <%= link_to "My orders", orders_path, class: "layouts-application__link" %>
        <%= link_to "My subscriptions", subscriptions_path, class: "layouts-application__link" %>
        <%= link_to "My addresses", addresses_path, class: "layouts-application__link" %>
      <% end %>
      <% if admin? %>
        <%= link_to "Orders", admin_orders_path, class: "layouts-application__link" %>
        <%= link_to "Import", new_admin_product_import_path, class: "layouts-application__link" %>
        <%= link_to "Announcements", admin_announcements_path, class: "layouts-application__link" %>
        <%= link_to "Featured", admin_featured_products_path, class: "layouts-application__link" %>
        <%= link_to "Users", admin_users_path, class: "layouts-application__link" %>
        <%= link_to "Subscribers", admin_subscribers_path, class: "layouts-application__link" %>
      <% end %>
      <div class="layouts-application__account">
        <% count = current_cart_count %>
        <%= link_to cart_path, class: "layouts-application__cart", aria: { label: "Cart, #{pluralize(count, "item")}" } do %>
          Cart<% if count.positive? %> <span class="layouts-application__cart-count"><%= count %></span><% end %>
        <% end %>
        <% if authenticated? %>
          <span class="layouts-application__greeting">Hi, <%= Current.user.first_name %>!</span>
          <%= button_to "Log out", session_path, method: :delete, class: "layouts-application__logout" %>
        <% else %>
          <%= link_to "Login", new_session_path, class: "layouts-application__logout layouts-application__login" %>
        <% end %>
      </div>
    </nav>

    <main class="layouts-application__main">
      <%# In the page flow, above the content, so they never cover a button.
          The roles make screen readers announce them. %>
      <%= tag.div(flash[:notice], class: "notice", role: "status") if flash[:notice] %>
      <%= tag.div(flash[:alert], class: "alert", role: "alert") if flash[:alert] %>
      <%= yield %>
    </main>
  </body>
</html>
