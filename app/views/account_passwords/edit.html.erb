<% content_for :title, "Change password" %>

<h1>Change password</h1>

<%= form_with model: @user, url: account_password_path, method: :patch, class: "form-card account__form" do |form| %>
  <% if @user.errors.any? %>
    <p class="error" data-testid="form-error"><%= @user.errors.full_messages.first %></p>
  <% end %>

  <div>
    <%= label_tag :current_password, "Current password" %>
    <%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password" %>
  </div>

  <div>
    <%= form.label :password, "New password" %>
    <%= form.password_field :password, required: true, minlength: User::PASSWORD_MINIMUM, maxlength: 72,
                            autocomplete: "new-password", aria: { describedby: "new-password-hint" } %>
    <p id="new-password-hint" class="admin-form__hint">At least <%= User::PASSWORD_MINIMUM %> characters. You'll stay logged in here, and be logged out on other devices.</p>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm new password" %>
    <%= form.password_field :password_confirmation, required: true, maxlength: 72, autocomplete: "new-password" %>
  </div>

  <%= form.submit "Change password" %>
<% end %>
<%= link_to "Cancel", account_path, class: "admin-page__cancel" %>
